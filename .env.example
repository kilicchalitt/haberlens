# HaberLens ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp düzenleyin.
# `.env` dosyası git tarafından yok sayılır; gerçek anahtarları asla commit etmeyin.

# /v1/* uç noktalarını korumak için API anahtarı (boş bırakılırsa kimlik doğrulama kapalı)
HABERLENS_API_KEY=

# Virgülle ayrılmış izinli kaynaklar, örn: https://cms.kurum.com.tr,https://panel.kurum.com.tr
HABERLENS_CORS_ORIGINS=

# Tek istekte en fazla kaç metin gönderilebilir
HABERLENS_MAX_BATCH_SIZE=256

# Tek bir metnin en fazla karakter uzunluğu
HABERLENS_MAX_TEXT_LENGTH=20000

# Model dosyasının yolu
HABERLENS_MODEL_PATH=models/haberlens.joblib

# Eğitim verisi (haberlens data build çıktısı)
HABERLENS_DATA_PATH=data/processed/news_corpus.csv
